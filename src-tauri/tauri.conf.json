{
  "build": {
    "beforeDevCommand": "node scripts/stage-native-host.mjs debug && npm run dev",
    "beforeBuildCommand": "node scripts/stage-native-host.mjs && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/tray-success.png",
      "icons/tray-failed.png",
      "icons/tray-pending.png"
    ],
    "externalBin": [
      "binaries/cignaler-native-host"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  },
  "productName": "cignaler",
  "mainBinaryName": "cignaler",
  "version": "0.0.3",
  "identifier": "com.ostwi.dev",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "visible": false,
        "fullscreen": false,
        "resizable": true,
        "title": "cignaler",
        "width": 1400,
        "height": 800,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  }
}
